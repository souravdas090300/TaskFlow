# Production Environment Variables
# Copy this file to .env.prod and fill in actual values
# NEVER commit .env.prod to version control

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Database Configuration
# Use a strong password for production
DB_HOST=db
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration
# Generate a secure key: openssl rand -base64 32
JWT_KEY=CHANGE_THIS_TO_SECURE_32_CHARACTER_KEY
JWT_ISSUER=TaskFlow
JWT_AUDIENCE=TaskFlowUsers

# Stripe Configuration
# Use LIVE keys for production (not test keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Order Settings
ORDER_TAX_RATE=0.18
ORDER_FREE_SHIPPING_THRESHOLD=50.00
ORDER_SHIPPING_COST=5.99
ORDER_CURRENCY=EUR

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# IMPORTANT: Verify your domain in Resend dashboard (SPF + DKIM) before using
# FromEmail must be on a verified domain
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# DuckDNS Configuration
DUCKDNS_SUBDOMAIN=taskflow-sourav
DUCKDNS_TOKEN=your-duckdns-token
