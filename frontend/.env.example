# API calls use same-origin /api (vite dev server proxies to localhost:5000).
# Only set VITE_API_URL to override (e.g. a remote API URL).
# Publishable key is safe to expose (it ships to the browser). Never put sk_... here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Google Client ID for the "Continue with Google" button (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
