# Example Environment Variables
# Copy this file to .env, .env.dev, or .env.prod and fill in actual values

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration
# Generate a secure key: openssl rand -base64 32
JWT_KEY=CHANGE_THIS_TO_SECURE_32_CHARACTER_KEY
JWT_ISSUER=TaskFlow
JWT_AUDIENCE=TaskFlowUsers

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
# Use official Stripe.net package (published by Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Order Settings
ORDER_TAX_RATE=0.18
ORDER_FREE_SHIPPING_THRESHOLD=50.00
ORDER_SHIPPING_COST=5.99
ORDER_CURRENCY=EUR

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# DuckDNS Configuration
# Get your token from: https://www.duckdns.org/
DUCKDNS_SUBDOMAIN=taskflow-sourav
DUCKDNS_TOKEN=your-duckdns-token
