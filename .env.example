# Example Environment Variables
# Copy this file to .env, .env.dev, or .env.prod and fill in actual values
#
# IMPORTANT: .NET config uses __ (double underscore) for nesting, e.g.
#   Stripe__SecretKey  ->  "Stripe": { "SecretKey": ... }
# Single-underscore names like STRIPE_SECRET_KEY do NOT bind.

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# Database Configuration ("db" = compose service name inside containers)
DB_HOST=db
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT Configuration (required in Production - app fails fast without it)
# Generate a secure key: openssl rand -base64 32
JWT__Key=CHANGE_THIS_TO_SECURE_32_CHARACTER_KEY
JWT__Issuer=TaskFlow
JWT__Audience=TaskFlowUsers

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
# Compose maps these to Authentication__Google__ClientId/ClientSecret
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
# Test keys for development, live keys (sk_live_/pk_live_) for production
Stripe__SecretKey=sk_test_your_stripe_secret_key
Stripe__WebhookSecret=whsec_your_webhook_secret
# Publishable key - baked into the frontend Docker image at build time (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# VITE_API_URL=   # empty = same-origin /api (recommended); override only for remote API

# Resend Email Configuration (only used when ASPNETCORE_ENVIRONMENT=Production)
# Get your API key from: https://resend.com/api-keys
# Verify your domain in Resend dashboard (SPF + DKIM) before using
Resend__ApiKey=re_your_resend_api_key
Resend__FromEmail=noreply@yourdomain.com

# Order Settings (optional - defaults live in appsettings.json)
# OrderSettings__TaxRate=0.18
# OrderSettings__FreeShippingThreshold=50.00
# OrderSettings__ShippingCost=5.99
# OrderSettings__Currency=EUR
# OrderSettings__AdminAlertEmail=admin@example.com

# DuckDNS Configuration
# Get your token from: https://www.duckdns.org/
# SUBDOMAIN ONLY - no .duckdns.org suffix
DUCKDNS_SUBDOMAIN=taskflow-das
DUCKDNS_TOKEN=your-duckdns-token

# Public base URL used to build Stripe success/cancel redirect URLs (required in production)
App__PublicUrl=https://your-domain.example.com
